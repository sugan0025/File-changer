<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Filee.App.Controls"
             x:Class="Filee.App.Controls.EnginePipelineControl">

  <UserControl.Styles>
    <Style Selector="Border.pipeline-node">
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.25" />
          <BrushTransition Property="Background" Duration="0:0:0.25" />
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="Border.pipeline-endnode">
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.25" />
          <BrushTransition Property="Background" Duration="0:0:0.25" />
          <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.pipeline-endnode:pointerover">
      <Setter Property="Opacity" Value="0.9" />
    </Style>
  </UserControl.Styles>

  <Border Classes="card" Padding="12,18,12,16" Margin="0,4,0,8"
          Background="{DynamicResource SurfaceBrush}"
          BorderBrush="{DynamicResource SubtleBorderBrush}"
          BorderThickness="1"
          CornerRadius="{DynamicResource SoftRadius}">
    <StackPanel Spacing="14">

      <!-- Responsive Canvas Container: scales gracefully across all screen sizes up to 1000px -->
      <Viewbox MaxWidth="1000" Stretch="Uniform" HorizontalAlignment="Center">
        <Canvas Width="1000" Height="330">

          <!-- 1. Native High-Performance Animated Particle Vector Canvas -->
          <controls:PipelineDrawingCanvas x:Name="Canvas" Width="1000" Height="330" />

          <!-- 2. Node 1: Input -->
          <Border x:Name="Node1Card" Canvas.Left="70" Canvas.Top="135" Width="160" Height="80"
                  Classes="pipeline-node"
                  Background="{DynamicResource SurfaceAltBrush}"
                  BorderBrush="{DynamicResource SubtleBorderBrush}">
            <StackPanel VerticalAlignment="Center" Margin="16,0">
              <TextBlock Text="INPUT" FontSize="9" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,4" />
              <TextBlock Text="File Sources" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
            </StackPanel>
          </Border>
          <TextBlock Text="documents · images · media"
                     Canvas.Left="50" Canvas.Top="225" Width="200" TextAlignment="Center"
                     FontSize="10" FontFamily="Consolas, monospace" Foreground="#9CA3AF" />

          <!-- 3. Node 2: Processing -->
          <Border x:Name="Node2Card" Canvas.Left="320" Canvas.Top="135" Width="160" Height="80"
                  Classes="pipeline-node"
                  Background="{DynamicResource SurfaceAltBrush}"
                  BorderBrush="{DynamicResource SubtleBorderBrush}">
            <StackPanel VerticalAlignment="Center" Margin="16,0">
              <TextBlock Text="PROCESSING" FontSize="9" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,4" />
              <TextBlock Text="Transformation" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
            </StackPanel>
          </Border>
          <TextBlock Text="clean · parse · validate"
                     Canvas.Left="300" Canvas.Top="225" Width="200" TextAlignment="Center"
                     FontSize="10" FontFamily="Consolas, monospace" Foreground="#9CA3AF" />

          <!-- 4. Node 3: Routing (Inverted Accent Hero Card) -->
          <Border x:Name="RoutingCard" Canvas.Left="570" Canvas.Top="135" Width="160" Height="80"
                  Classes="pipeline-node" BoxShadow="0 10 25 0 #40000000">
            <StackPanel VerticalAlignment="Center" Margin="16,0">
              <TextBlock x:Name="RoutingLabel" Text="ROUTING" FontSize="9" FontWeight="Bold" Margin="0,0,0,3" />
              <TextBlock x:Name="RoutingTitle" Text="Logic Engine" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6" />
              <!-- Animated Processing Dots -->
              <StackPanel Orientation="Horizontal" Spacing="5">
                <Ellipse x:Name="Dot0" Width="4" Height="4" />
                <Ellipse x:Name="Dot1" Width="4" Height="4" />
                <Ellipse x:Name="Dot2" Width="4" Height="4" />
              </StackPanel>
            </StackPanel>
          </Border>
          <TextBlock Text="filter · map · dispatch"
                     Canvas.Left="550" Canvas.Top="225" Width="200" TextAlignment="Center"
                     FontSize="10" FontFamily="Consolas, monospace" Foreground="#9CA3AF" />

          <!-- 5. End Node 0: Graphics & Images -->
          <Border x:Name="EndNode0" Canvas.Left="800" Canvas.Top="51" Width="160" Height="48"
                  Classes="pipeline-endnode" PointerPressed="OnNode0Pressed">
            <DockPanel Margin="14,0">
              <Border x:Name="DotNode0" DockPanel.Dock="Right" Width="8" Height="8" CornerRadius="99" VerticalAlignment="Center" />
              <TextBlock x:Name="TextNode0" Text="Graphics &amp; Images" FontSize="13" VerticalAlignment="Center" />
            </DockPanel>
          </Border>

          <!-- 6. End Node 1: Audio & Video -->
          <Border x:Name="EndNode1" Canvas.Left="800" Canvas.Top="151" Width="160" Height="48"
                  Classes="pipeline-endnode" PointerPressed="OnNode1Pressed">
            <DockPanel Margin="14,0">
              <Border x:Name="DotNode1" DockPanel.Dock="Right" Width="8" Height="8" CornerRadius="99" VerticalAlignment="Center" />
              <TextBlock x:Name="TextNode1" Text="Audio &amp; Video" FontSize="13" VerticalAlignment="Center" />
            </DockPanel>
          </Border>

          <!-- 7. End Node 2: Office & Docs -->
          <Border x:Name="EndNode2" Canvas.Left="800" Canvas.Top="251" Width="160" Height="48"
                  Classes="pipeline-endnode" PointerPressed="OnNode2Pressed">
            <DockPanel Margin="14,0">
              <Border x:Name="DotNode2" DockPanel.Dock="Right" Width="8" Height="8" CornerRadius="99" VerticalAlignment="Center" />
              <TextBlock x:Name="TextNode2" Text="Office &amp; Docs" FontSize="13" VerticalAlignment="Center" />
            </DockPanel>
          </Border>

        </Canvas>
      </Viewbox>

      <!-- 8. Bottom Dynamic Console Info Bar -->
      <Border MaxWidth="960" Margin="16,0,16,2" Padding="18,12"
              Background="{DynamicResource SurfaceAltBrush}"
              BorderBrush="{DynamicResource SubtleBorderBrush}"
              BorderThickness="1"
              CornerRadius="12">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock Text="›" FontFamily="Consolas, monospace" FontSize="16" FontWeight="Bold" Foreground="#9CA3AF" VerticalAlignment="Center" />
          <TextBlock x:Name="StatusInfoText" FontFamily="Consolas, monospace" FontSize="13"
                     Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

    </StackPanel>
  </Border>
</UserControl>

