<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Filee.App.Views.ClipboardNoticeWindow"
        Title="HOOT"
        Width="404"
        SizeToContent="Height"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        CanResize="False">
  <Border Classes="card" Margin="24" Padding="14,12">
    <DockPanel>
      <Image DockPanel.Dock="Left" Source="avares://Filee/Assets/Icons/filee.png" Width="32" Height="32"
             VerticalAlignment="Top" Margin="0,2,10,0" />
      <StackPanel Spacing="6">
        <DockPanel>
          <Button DockPanel.Dock="Right" Classes="icon" Padding="4" VerticalAlignment="Top" Click="OnClose"
                  AutomationProperties.Name="Close">
            <PathIcon Width="11" Height="11" Data="{StaticResource Icon.Close}" />
          </Button>
          <TextBlock x:Name="TitleText" Text="Clipboard content ready" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
        </DockPanel>
        <TextBlock x:Name="DescriptionText" Classes="caption" Text="New image or file copied. Convert with HOOT?" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
          <Button Classes="accent" Click="OnConvert" Padding="12,5" Content="Convert now" />
          <Button Content="Dismiss" Click="OnClose" Padding="12,5" />
        </StackPanel>
      </StackPanel>
    </DockPanel>
  </Border>
</Window>

