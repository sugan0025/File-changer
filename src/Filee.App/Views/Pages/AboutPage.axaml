<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Filee.App.ViewModels.Pages"
             xmlns:c="using:Filee.App.Controls"
             xmlns:v="using:Filee.App.Views"
             x:Class="Filee.App.Views.Pages.AboutPage"
             x:DataType="vm:AboutPageViewModel">
  <StackPanel Spacing="18">
    <TextBlock Classes="h1" Text="{DynamicResource about.title}" />
    <Border Classes="card">
      <StackPanel Orientation="Horizontal" Spacing="18">
        <Image Source="avares://Filee/Assets/Icons/filee.png" Width="72" Height="72" />
        <StackPanel VerticalAlignment="Center" Spacing="4">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="Filee" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
            <!-- The version as a small pill, tinted with the accent (it follows the accent the user picked). The text colour
                 is set in the code-behind: the accent itself on dark, the deeper accent on light. -->
            <Border Classes="badge" Padding="10,3" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center"
                    AutomationProperties.Name="{Binding Version}">
              <TextBlock x:Name="VersionText" Text="{Binding VersionBadge}" FontSize="12" FontWeight="Bold"
                         Foreground="{DynamicResource AccentBrush}" />
            </Border>
          </StackPanel>

          <TextBlock Classes="muted" Text="Developer: Suganesan S." />
          <TextBlock Classes="muted" Text="{DynamicResource about.license}" />
          <Button Classes="ghost" Padding="0" Click="OnOpenRepository" Margin="0,4,0,0">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Width="13" Height="13" Data="{StaticResource Icon.Link}" Foreground="{DynamicResource AccentBrush}" />
              <TextBlock Text="{Binding RepositoryUrl}" Foreground="{DynamicResource AccentBrush}" />
            </StackPanel>
          </Button>
          <!-- This version's "What's new" slides again -->
          <Button x:Name="WhatsNewLink" Classes="ghost" Padding="0" Command="{Binding ShowWhatsNewCommand}" IsVisible="{Binding HasWhatsNew}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Width="13" Height="13" Data="{StaticResource Icon.Info}" Foreground="{DynamicResource AccentBrush}" />
              <TextBlock Text="{Binding WhatsNewText}" Foreground="{DynamicResource AccentBrush}" />
            </StackPanel>
          </Button>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- The sponsors right below Filee itself, while there are any -->
    <Border Classes="card" IsVisible="{Binding #Supporters.IsVisible}">
      <StackPanel Spacing="12">
        <TextBlock Classes="h2" Text="{DynamicResource sponsor.thanks}" />
        <v:SupportersView x:Name="Supporters" ShowTitle="False" LogoHeight="40" />
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel Spacing="12">
        <TextBlock Classes="h2" Text="{DynamicResource about.updates}" />
        <ToggleSwitch Content="{DynamicResource general.check_updates}" IsChecked="{Binding CheckForUpdates}" />
        <WrapPanel>
          <Button Command="{Binding CheckNowCommand}" Margin="0,0,10,0">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <!-- Turns while the check runs (Spin.IsActive follows CheckNowCommand.IsRunning; the code is in Controls/Spin.cs). -->
              <PathIcon c:Spin.IsActive="{Binding CheckNowCommand.IsRunning}"
                        Width="13" Height="13" Data="{StaticResource Icon.Refresh}" />
              <TextBlock Text="{DynamicResource general.check_now}" />
            </StackPanel>
          </Button>
          <Button Classes="accent" Command="{Binding DownloadUpdateCommand}" IsVisible="{Binding UpdateAvailable}" Margin="0,0,10,0">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Width="13" Height="13" Data="{StaticResource Icon.Download}" />
              <TextBlock Text="{Binding UpdateButtonText}" />
            </StackPanel>
          </Button>
          <TextBlock Classes="muted" VerticalAlignment="Center" Text="{Binding UpdateStatus}" />
        </WrapPanel>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
