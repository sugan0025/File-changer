<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Filee.App.ViewModels.Pages"
             xmlns:svc="using:Filee.App.Services"
             xmlns:controls="using:Filee.App.Controls"
             x:Class="Filee.App.Views.Pages.EnginesPage"
             x:DataType="vm:EnginesPageViewModel">
  <UserControl.Styles>
    <!-- Liquid Morphed Glass Master Card -->
    <Style Selector="Border.liquid-glass-master">
      <Setter Property="Background" Value="#35141926" />
      <Setter Property="BorderBrush" Value="#45FFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="24" />
      <Setter Property="BoxShadow" Value="0 20 50 0 #50000000, 0 1 0 0 #60FFFFFF, inset 0 1 1 0 #30FFFFFF" />
    </Style>

    <!-- Liquid Console Bar -->
    <Style Selector="Border.liquid-console-bar">
      <Setter Property="Background" Value="#2B1A2030" />
      <Setter Property="BorderBrush" Value="#40FFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="BoxShadow" Value="0 8 24 0 #30000000, 0 1 0 0 #35FFFFFF, inset 0 1 0 0 #18FFFFFF" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.2" />
          <BrushTransition Property="Background" Duration="0:0:0.2" />
          <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.2" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.liquid-console-bar:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Background" Value="#3D222B40" />
      <Setter Property="BoxShadow" Value="0 12 32 0 #45000000, 0 1 0 0 #60FFFFFF, inset 0 1 0 0 #30FFFFFF" />
    </Style>

    <!-- Liquid Glass Subcards for Packages & Engines -->
    <Style Selector="Border.liquid-glass-subcard">
      <Setter Property="Background" Value="#22161A26" />
      <Setter Property="BorderBrush" Value="#30FFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="BoxShadow" Value="0 6 20 0 #20000000, 0 1 0 0 #25FFFFFF, inset 0 1 0 0 #10FFFFFF" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.18" />
          <BrushTransition Property="Background" Duration="0:0:0.18" />
          <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.18" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.liquid-glass-subcard:pointerover">
      <Setter Property="BorderBrush" Value="#65FFFFFF" />
      <Setter Property="Background" Value="#321D2336" />
      <Setter Property="BoxShadow" Value="0 10 28 0 #35000000, 0 1 0 0 #50FFFFFF, inset 0 1 0 0 #20FFFFFF" />
    </Style>

    <!-- Dragging engine card in liquid glass -->
    <Style Selector="Border.card.engine.dragging">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BoxShadow" Value="0 14 36 0 #60000000, 0 0 20 0 #608E85F3, 0 1 0 0 #80FFFFFF" />
      <Setter Property="ZIndex" Value="1" />
    </Style>
  </UserControl.Styles>

  <!-- Keep editor columns usable on narrow windows; the page still scrolls vertically in MainWindow. -->
  <ScrollViewer x:Name="EditorScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
    <StackPanel Spacing="16" MinWidth="660" Width="{Binding #EditorScroller.Viewport.Width}" HorizontalAlignment="Left">
      <DockPanel>
        <Button DockPanel.Dock="Right" Command="{Binding RecheckCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Width="13" Height="13" Data="{StaticResource Icon.Refresh}" />
            <TextBlock Text="{DynamicResource engines.recheck}" />
          </StackPanel>
        </Button>
        <StackPanel>
          <TextBlock Classes="h1" Text="{DynamicResource engines.title}" />
          <TextBlock Classes="muted" TextWrapping="Wrap" Text="{DynamicResource engines.description}" />
        </StackPanel>
      </DockPanel>

      <!-- Unified Conversion Pipeline Interface: Liquid Morphed Glass Master Container -->
      <Border Classes="liquid-glass-master" Padding="14,18,14,18" Margin="0,2,0,16">
        <StackPanel Spacing="16">

          <!-- 1. The Vector Animated Diagram with Longer Node Lines (190px span ⚟) -->
          <controls:EnginePipelineControl x:Name="PipelineControl"
                                          ActiveIndex="{Binding SelectedCategory, Mode=TwoWay}"
                                          IsDropdownOpen="{Binding IsDropdownOpen, Mode=TwoWay}" />

          <!-- 2. The Bottom Console Bar with Dropdown Toggle ('>' rotates/becomes '▼' when open) -->
          <Border x:Name="ConsoleBar" MaxWidth="1180" Margin="8,0,8,0" Padding="20,13"
                  Classes="liquid-console-bar"
                  Cursor="Hand"
                  PointerPressed="OnConsoleBarPressed">
            <DockPanel LastChildFill="True">
              <!-- Right: Expand/Collapse indicator badge -->
              <Border DockPanel.Dock="Right" Classes="badge" VerticalAlignment="Center" Margin="12,0,0,0">
                <TextBlock Classes="caption" Text="{Binding DropdownToggleHint}" />
              </Border>

              <!-- Left: The glyph ('>' rotates/becomes '▼' when open) -->
              <TextBlock DockPanel.Dock="Left" Text="{Binding DropdownGlyph}"
                         FontFamily="Consolas, monospace" FontSize="16" FontWeight="Bold"
                         Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />

              <!-- Center: Authentic Conversion Status Text (No Database / Dashboard / Email Service!) -->
              <TextBlock Text="{Binding ActiveStatusText}"
                         FontFamily="Consolas, monospace" FontSize="13"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
          </Border>

          <!-- 3. The Expandable Dropdown Container (Merged Optional + All Engines in Liquid Glass) -->
          <StackPanel IsVisible="{Binding IsDropdownOpen}" Spacing="14" MaxWidth="1180" Margin="8,4,8,6">

            <!-- Category Header & Description in Liquid Frosted Glass -->
            <Border Classes="liquid-glass-subcard" Padding="18,12">
              <DockPanel>
                <StackPanel Spacing="3">
                  <TextBlock FontWeight="SemiBold" FontSize="14" Text="{Binding CategoryTitle}" Foreground="{DynamicResource TextPrimaryBrush}" />
                  <TextBlock Classes="caption muted" Text="{Binding CategoryDescription}" />
                </StackPanel>
              </DockPanel>
            </Border>

            <!-- Optional Engines matching this category (Install, Settings, Use own copy, Remove) -->
            <ItemsControl ItemsSource="{Binding FilteredPackages}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="10" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="svc:EnginePackageState">
                  <Border Classes="card engine liquid-glass-subcard" Padding="18,14">
                    <DockPanel>
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Button IsVisible="{Binding HasSettings}" Click="OnPackageSettings" ToolTip.Tip="{DynamicResource engines.lo_title}">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Width="13" Height="13" Data="{StaticResource Icon.Settings}" />
                            <TextBlock Text="{DynamicResource engines.settings}" />
                          </StackPanel>
                        </Button>
                        <Button Classes="accent" Content="{DynamicResource engines.install}" IsVisible="{Binding CanInstall}"
                                Command="{Binding $parent[ItemsControl].((vm:EnginesPageViewModel)DataContext).InstallCommand}" CommandParameter="{Binding}" />
                        <Button Classes="accent" Content="{DynamicResource engines.update}" IsVisible="{Binding CanUpdate}"
                                Command="{Binding $parent[ItemsControl].((vm:EnginesPageViewModel)DataContext).InstallCommand}" CommandParameter="{Binding}" />
                        <Button Content="{DynamicResource engines.cancel}" IsVisible="{Binding IsBusy}"
                                Command="{Binding $parent[ItemsControl].((vm:EnginesPageViewModel)DataContext).CancelCommand}" CommandParameter="{Binding}" />
                        <Button Content="{DynamicResource engines.use_own}" IsVisible="{Binding CanUseOwnCopy}" Click="OnUseOwnCopy"
                                ToolTip.Tip="{DynamicResource engines.use_own_hint}" />
                        <Button Content="{DynamicResource engines.stop_own}" IsVisible="{Binding UsesOwnCopy}" Click="OnStopOwnCopy" />
                        <Button Content="{DynamicResource engines.remove}" IsVisible="{Binding CanRemove}" Click="OnRemove" />
                      </StackPanel>
                      <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                          <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                          <Border Classes="badge">
                            <TextBlock Classes="caption" Text="{Binding StatusText}" />
                          </Border>
                        </StackPanel>
                        <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding Description}" />
                        <TextBlock Classes="caption" Text="{Binding Sizes}" IsVisible="{Binding !UsesOwnCopy}" />
                        <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding InstallGuidance}"
                                   IsVisible="{Binding InstallGuidance, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <TextBlock Classes="caption" Text="{Binding OwnCopyFolder}" IsVisible="{Binding ShowsCopyFolder}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="caption" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Text="{Binding UpdateNote}"
                                   IsVisible="{Binding UpdateNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <ProgressBar Classes="soft" Maximum="100" Value="{Binding Progress}" IsVisible="{Binding IsBusy}" Margin="0,4,0,0" />
                        <TextBlock Classes="caption" Text="{Binding ProgressDetail}" IsVisible="{Binding ProgressDetail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- All / Installed Engines matching this category: drag a card (or use its arrows) to change the priority order -->
            <ItemsControl x:Name="EngineList" ItemsSource="{Binding FilteredEngines}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="10" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:EngineItemViewModel">
                  <Border Classes="card engine liquid-glass-subcard" Classes.dragging="{Binding IsDragging}" Padding="18,14" Cursor="SizeNorthSouth"
                          PointerPressed="OnEnginePressed">
                    <StackPanel Spacing="10">
                      <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
                          <Button Classes="icon" ToolTip.Tip="{DynamicResource engines.move_up}" AutomationProperties.Name="{DynamicResource engines.move_up}"
                                  Command="{Binding $parent[ItemsControl].((vm:EnginesPageViewModel)DataContext).MoveUpCommand}" CommandParameter="{Binding}">
                            <PathIcon Width="14" Height="14" Data="{StaticResource Icon.ArrowUp}" />
                          </Button>
                          <Button Classes="icon" ToolTip.Tip="{DynamicResource engines.move_down}" AutomationProperties.Name="{DynamicResource engines.move_down}"
                                  Command="{Binding $parent[ItemsControl].((vm:EnginesPageViewModel)DataContext).MoveDownCommand}" CommandParameter="{Binding}">
                            <PathIcon Width="14" Height="14" Data="{StaticResource Icon.ArrowDown}" />
                          </Button>
                        </StackPanel>
                        <PathIcon DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,10,0" Opacity="0.5" VerticalAlignment="Center"
                                  Data="{StaticResource Icon.DragVertical}" />
                        <Border DockPanel.Dock="Left" Width="10" Height="10" CornerRadius="999" Margin="2,0,12,0" VerticalAlignment="Center"
                                Background="{DynamicResource SuccessBrush}" IsVisible="{Binding IsAvailable}" />
                        <Border DockPanel.Dock="Left" Width="10" Height="10" CornerRadius="999" Margin="2,0,12,0" VerticalAlignment="Center"
                                Background="{DynamicResource TextSecondaryBrush}" IsVisible="{Binding !IsAvailable}" />
                        <StackPanel Spacing="3" ToolTip.Tip="{Binding Detail}">
                          <WrapPanel Orientation="Horizontal">
                            <TextBlock FontWeight="SemiBold" Text="{Binding Name}" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <Border Classes="badge" Margin="0,0,8,0">
                              <TextBlock Classes="caption" Text="{Binding StatusText}" />
                            </Border>
                            <TextBlock Classes="caption" VerticalAlignment="Center" Margin="0,0,8,0" Text="{Binding Version}"
                                       IsVisible="{Binding Version, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Classes="caption" VerticalAlignment="Center" Text="{Binding Conversions}" />
                          </WrapPanel>
                          <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding Description}"
                                     IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                      </DockPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

          </StackPanel>

        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
